{
  "name": "comp5241-minicourse-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --import=tsx scripts/run-e2e.ts",
    "test:production": "node --import=tsx tests/live/production.ts",
    "test:ai:tutor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx tests/live/tutor.ts",
    "test:ai:tutor:acceptance": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx tests/live/tutor-acceptance.ts",
    "test:ai:client:acceptance": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import=tsx tests/live/client.ts",
    "test:ai:feedback:acceptance": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import=tsx tests/live/feedback.ts",
    "test:ai:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import=tsx tests/live/capability.ts"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "openai": "7.36.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
